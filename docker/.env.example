# ──────────────────────────────────────────────────────────────
# Docker Compose environment template. Copy to .env in this folder
# before running `docker compose up`:
#     cp .env.example .env
# .env is git-ignored at the repo level.
# ──────────────────────────────────────────────────────────────

# ── PostgreSQL ──────────────────────────────────────────────────
DB_PASSWORD=change-me-in-production

# ── Flask ───────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
DEBUG=false

# ── Model inference ─────────────────────────────────────────────
# Lower values (0.30–0.40) → higher recall but more false positives.
MODEL_CONFIDENCE=0.35

# ── Motion detection ────────────────────────────────────────────
MOTION_THRESHOLD=5000
MOTION_DELAY_SEC=1.5

# ── IP-camera (optional) ────────────────────────────────────────
# Leave default if you'll only use file uploads.
RTSP_URL=rtsp://192.168.1.100/stream
