# Build-context exclusions for `docker build .` from the repository root.
# Build context = parent directory of this Dockerfile (see compose context: ..).

# ── Python ──────────────────────────────────────────────────────────────────
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache

# ── Virtual environments ────────────────────────────────────────────────────
**/venv
**/.venv
**/env
**/ENV

# ── Git / IDE / OS ──────────────────────────────────────────────────────────
.git
.gitignore
**/.DS_Store
**/.vscode
**/.idea
**/*.swp

# ── Secrets ─────────────────────────────────────────────────────────────────
**/.env
**/.env.local
**/.env.production

# ── Model training is NOT shipped inside the recognition image ──────────────
model_training/

# ── Documentation (slims down build context) ────────────────────────────────
README.md
ARCHITECTURE.md
LICENSE
docker/

# ── Recognition runtime artifacts (mounted as volumes, not built-in) ────────
shooting_recognition/uploads/*
!shooting_recognition/uploads/.gitkeep

shooting_recognition/outputs/
shooting_recognition/calibration/zones.json

# Weights are mounted as a volume — don't bake them into the image.
shooting_recognition/recognition/weights/*.pt
shooting_recognition/recognition/weights/*.onnx
shooting_recognition/recognition/weights/*.engine

# ── Notebooks artifacts ─────────────────────────────────────────────────────
**/.ipynb_checkpoints
