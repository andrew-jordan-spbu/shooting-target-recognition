# Flask settings
SECRET_KEY=change-me-in-production
DEBUG=true
PORT=5000

# PostgreSQL settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shooting_recognition
DB_USER=postgres
DB_PASSWORD=postgres

# Camera / Video source
RTSP_URL=rtsp://user:password@192.168.1.100:554/stream

# Model and motion settings
MODEL_CONFIDENCE=0.35
MOTION_THRESHOLD=5000
MOTION_DELAY_SEC=1.5
