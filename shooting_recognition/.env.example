# ──────────────────────────────────────────────────────────────
# .env.example — копируйте в .env и заполните своими значениями.
#                Файл .env не должен попадать в git (.gitignore).
# ──────────────────────────────────────────────────────────────

# ── Flask ─────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
DEBUG=true
PORT=5000

# ── PostgreSQL (локальная установка) ──────────────────────────
# Перед первым запуском: createdb shooting_recognition
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shooting_recognition
DB_USER=postgres
DB_PASSWORD=

# ── IP-камера (опционально, если будете использовать RTSP) ────
RTSP_URL=rtsp://192.168.1.100/stream

# ── Детектор движения ─────────────────────────────────────────
# MOTION_THRESHOLD — минимальное число изменившихся пикселей,
#                   при котором кадр считается «с движением»
# MOTION_DELAY_SEC — минимальный интервал между срабатываниями (антидребезг)
MOTION_THRESHOLD=5000
MOTION_DELAY_SEC=1.5

# ── Порог уверенности модели ──────────────────────────────────
# Значения 0.30–0.45 обычно дают лучший recall.
# 0.50 — дефолт ultralytics (более строгий).
MODEL_CONFIDENCE=0.35
